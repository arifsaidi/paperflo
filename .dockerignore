# Vendor dependencies (installed in Dockerfile)
vendor/

# Node packages (installed in Dockerfile)
node_modules/

# Local environment files
.env
.env.local
.env.*.local

# Version control
.git/
.gitignore

# IDE/editor files
.cursor/
.vscode/
*.swp
*.swo

# Build artifacts already handled by docker
public/hot

# Test/dev files
tests/
phpunit.xml

# Logs
storage/logs/*.log

# Docker files themselves don't need to be in the image context cache
docker-compose*.yml
