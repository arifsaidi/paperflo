APP_NAME=PaperFlo
APP_ENV=production
APP_KEY=base64:92XE+AHjyjHwUnW/J2sBpb245LI/9ZwyaQVCmokA1zs=                          # REQUIRED: run `php artisan key:generate --show` locally and paste here
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql          # matches the docker-compose service name
DB_PORT=3306
DB_DATABASE=paperflo
DB_USERNAME=paperflo
DB_PASSWORD=secret

# ─── Session / Cache / Queue ─────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail ────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@paperflo.test"
MAIL_FROM_NAME="PaperFlo"

# ─── Reverb (WebSockets) ─────────────────────────────────
REVERB_APP_ID=215721
REVERB_APP_KEY=mzy52sopvrot25wwruds
REVERB_APP_SECRET=rzkk6qn9pbexeibte8zd
REVERB_HOST=reverb          # matches the docker-compose service name
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"
